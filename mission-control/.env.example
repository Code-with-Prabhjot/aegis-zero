# AEGIS-0 Mission Control Environment Configuration
# Orchestrator URL (FastAPI). The WebSocket URL is automatically derived from it unless set.
# For local development:
NEXT_PUBLIC_AEGIS_API=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For production deployment (e.g. Render backend with Vercel frontend):
# NEXT_PUBLIC_AEGIS_API=https://aegis-zero.onrender.com
# NEXT_PUBLIC_API_BASE_URL=https://aegis-zero.onrender.com
# NEXT_PUBLIC_AEGIS_WS=wss://aegis-zero.onrender.com
# NEXT_PUBLIC_WS_BASE_URL=wss://aegis-zero.onrender.com

# Backend proxy rewrite (only active in development or when explicitly set)
BACKEND_URL=http://127.0.0.1:8000

# Model labels (keep in sync with orchestrator/.env)
# NEXT_PUBLIC_AEGIS_FRONTIER_MODEL=claude-sonnet-4-20250514
# NEXT_PUBLIC_AEGIS_MICRO_MODEL=gpt-4o
# NEXT_PUBLIC_AEGIS_LOCAL_MODEL=deepseek-coder-v2
