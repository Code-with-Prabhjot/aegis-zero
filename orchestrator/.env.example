BIFROST_GATEWAY_URL=http://localhost:8080/v1
BIFROST_API_KEY=bifrost-local-dev-key
TAVILY_API_KEY=your_tavily_api_key_here
OLLAMA_ENCLAVE_URL=http://localhost:11434
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_USER_BUDGET_USD=0.50
DEFAULT_SESSION_BUDGET_USD=0.10

# --- Models (see orchestrator/model_registry.py) ---
AEGIS_FRONTIER_MODEL=claude-opus-5-5
# Cross-provider failover target; confirm the ID against your provider's current model list.
AEGIS_FALLBACK_MODEL=gpt-5.6
AEGIS_FALLBACK_PROVIDER=openai
AEGIS_MICRO_MODEL=claude-haiku-5-5
AEGIS_LOCAL_MODEL=deepseek-coder-v2
# Per-tier price overrides: input,output[,cache_read[,cache_write]] USD per 1M tokens
# AEGIS_FRONTIER_PRICE=4,20,0.20,5
# AEGIS_MICRO_PRICE=0.10,0.50,0.01,0.125

# --- Action gate & workspace ---
AEGIS_SECRET_KEY=change-me-in-production
AEGIS_ACTION_TTL_SECONDS=900
# Approved writes land here (defaults to <repo>/.aegis-workspace sandbox)
# AEGIS_WORKSPACE_ROOT=/path/to/checkout
AEGIS_MAX_EXPANSION_ROUNDS=2
# Set to 1 to disable PyPI lookups (offline demos / CI)
AEGIS_PYPI_OFFLINE=0

# Allowed browser origins for the workbench (comma-separated)
AEGIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
